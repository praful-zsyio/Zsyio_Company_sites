  "cross_app_integrations": [
    {
      "flow": "Deal to Delivery",
      "description": "Closed-Won deals in Zsyio Pulse automatically scaffold client accounts and delivery sprint backlogs in Zsyio Flow."
    },
    {
      "flow": "Task to RFC",
      "description": "Engineering tickets in Zsyio Flow embed and bi-directionally sync with technical specs and ADRs authored in Zsyio Canvas."
    },
    {
      "flow": "Capacity-Aware Sprints",
      "description": "Sprint workload distribution in Zsyio Flow factors in live team attendance, shift intervals, and approved leaves from Zsyio People."
    },
    {
      "flow": "Unified Governance",
      "description": "Tenant context, authentication, and the 56-action RBAC matrix are universally enforced across all ports by Zsyio Console."
    }
  ],
